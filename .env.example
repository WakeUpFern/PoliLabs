# Solo desarrollo local. Sustituye CHANGE_ME en ambos valores.
POSTGRES_USER=labora
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=labora_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://labora:CHANGE_ME@localhost:5433/labora_dev
# Opcional; las pruebas derivan labora_dev_test si se omite.
TEST_DATABASE_URL=postgresql://labora:CHANGE_ME@localhost:5433/labora_test

# Better Auth. Genera un secreto aleatorio de al menos 32 caracteres fuera del repositorio.
BETTER_AUTH_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# Opcional; orígenes extra separados por comas, p. ej. la dirección Network de `pnpm dev`
# para entrar desde el celular. También habilita esos hosts en allowedDevOrigins.
BETTER_AUTH_TRUSTED_ORIGINS=

# Documentos (solo adaptador de disco local). Carpeta ignorada por git, fuera de public/.
# Opcional; por defecto .local-storage/documents relativa al proyecto.
DOCUMENT_STORAGE_DIR=.local-storage/documents

# Correo transaccional (Notifications I). Solo existe el adaptador local de archivos .eml.
# Opcionales; file por defecto. disabled deja las entregas pendientes.
EMAIL_TRANSPORT=file
EMAIL_FROM=Labora <no-reply@labora.invalid>
EMAIL_OUTBOX_DIR=.local-storage/email-outbox

# Datos de demostración locales (pnpm seed:demo). Contraseña de las cuentas sintéticas
# responsable@, profesor@ y alumno@demo.invalid; mínimo 12 caracteres.
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
